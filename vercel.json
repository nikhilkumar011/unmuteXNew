{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/verify", "destination": "/certificate/index.html" },
    { "source": "/verify/:name", "destination": "/verify/index.html" },
    { "source": "/team", "destination": "/team/index.html" },
    { "source": "/book", "destination": "/book/index.html" },
    { "source": "/feedback", "destination": "/feedback/index.html" },
    { "source": "/certificate", "destination": "/certificate/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
